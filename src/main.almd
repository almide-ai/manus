// manus — a Claude computer-use agent for macOS, written in Almide.
//
// Claude sees the screen (screencapture), decides, and acts (cliclick)
// through the Anthropic Messages API computer-use tool. Give it a task
// as a CLI argument; it loops screenshot → think → act until done.
//
// Every action asks for confirmation unless MANUS_YOLO=1.
// Requires: ANTHROPIC_API_KEY, `cliclick` on PATH, and Screen Recording
// + Accessibility permission granted to the running terminal.

import process
import json
import io
import env
import http

let VERSION = "0.1.0"
let MAX_STEPS = 40
let BETA = "computer-use-2025-01-24"
let TOOL_TYPE = "computer_20250124"

fn default_model() -> String = "claude-sonnet-4-6"

let SYSTEM_PROMPT =
  "You are manus, controlling a real macOS desktop through the computer " +
  "tool. Coordinates are in logical screen points matching the screenshot " +
  "you are given. Work in small steps: take a screenshot when unsure, click " +
  "precisely, and verify the result on the next screenshot. Be careful — " +
  "this is the user's real machine. When the task is complete, stop and " +
  "summarize what you did in one sentence."

// ── shell ──
effect fn sh(cmd: String) -> Result[String, String] =
  process.exec("/bin/sh", ["-c", cmd])

effect fn click(args: List[String]) -> Result[String, String] =
  process.exec("cliclick", args)

// ── screen geometry ──
type Size = { w: Int, h: Int }

effect fn screen_size() -> Result[Size, String] = {
  let raw = sh("osascript -e 'tell application \"Finder\" to get bounds of window of desktop'")!
  let parts = list.map(string.split(string.trim(raw), ","), (p) => string.trim(p))
  guard list.len(parts) >= 4 else err("cannot parse screen bounds: ${raw}")
  let w = int.parse(list.get_or(parts, 2, "0"))!
  let h = int.parse(list.get_or(parts, 3, "0"))!
  ok(Size { w: w, h: h })
}

// Capture the screen and downscale the Retina image to logical points so
// Claude's coordinates line up 1:1 with cliclick's coordinate space.
// Returns a base64 PNG with no line breaks.
effect fn screenshot(sz: Size) -> Result[String, String] = {
  let _ = sh("screencapture -x /tmp/manus.png")!
  let _ = sh("sips --resampleHeightWidth ${int.to_string(sz.h)} ${int.to_string(sz.w)} /tmp/manus.png >/dev/null 2>&1")!
  sh("base64 -i /tmp/manus.png | tr -d '\\n'")
}

// ── JSON content-block builders ──
fn text_block(t: String) -> Value =
  json.object([("type", json.from_string("text")), ("text", json.from_string(t))])

fn image_block(b64: String) -> Value =
  json.object([
    ("type", json.from_string("image")),
    ("source", json.object([
      ("type", json.from_string("base64")),
      ("media_type", json.from_string("image/png")),
      ("data", json.from_string(b64)),
    ])),
  ])

fn msg(role: String, content: Value) -> Value =
  json.object([("role", json.from_string(role)), ("content", content)])

fn computer_tool(sz: Size) -> Value =
  json.object([
    ("type", json.from_string(TOOL_TYPE)),
    ("name", json.from_string("computer")),
    ("display_width_px", json.from_int(sz.w)),
    ("display_height_px", json.from_int(sz.h)),
    ("display_number", json.from_int(1)),
  ])

// ── action helpers ──
fn getf(input: Value, key: String) -> String =
  json.get_string(input, key) |> option.unwrap_or("")

fn coord(input: Value) -> (Int, Int) = {
  let xs = json.get_array(input, "coordinate") |> option.unwrap_or([])
  let x = list.get(xs, 0) |> option.flat_map((v) => json.as_int(v)) |> option.unwrap_or(0)
  let y = list.get(xs, 1) |> option.flat_map((v) => json.as_int(v)) |> option.unwrap_or(0)
  (x, y)
}

// Map an X11-style modifier name to cliclick's name.
fn one_modifier(m: String) -> String =
  match m {
    "cmd" => "cmd", "command" => "cmd", "super" => "cmd",
    "ctrl" => "ctrl", "control" => "ctrl",
    "alt" => "alt", "option" => "alt",
    "shift" => "shift",
    _ => "",
  }

// Map an X11-style key name to a cliclick key-press command.
fn key_press(name: String) -> List[String] =
  match name {
    "Return" => ["kp:return"], "Enter" => ["kp:return"], "return" => ["kp:return"],
    "Escape" => ["kp:esc"], "escape" => ["kp:esc"], "Esc" => ["kp:esc"],
    "Tab" => ["kp:tab"], "space" => ["kp:space"], "Space" => ["kp:space"],
    "BackSpace" => ["kp:delete"], "Delete" => ["kp:delete"], "delete" => ["kp:delete"],
    "Left" => ["kp:arrow-left"], "Right" => ["kp:arrow-right"],
    "Up" => ["kp:arrow-up"], "Down" => ["kp:arrow-down"],
    "Home" => ["kp:home"], "End" => ["kp:end"],
    "Page_Up" => ["kp:page-up"], "Page_Down" => ["kp:page-down"],
    _ => ["t:" + name],
  }

fn key_args(combo: String) -> List[String] = {
  let parts = string.split(combo, "+")
  let n = list.len(parts)
  let mods = list.take(parts, n - 1) |> list.map(one_modifier) |> list.filter((m) => m != "")
  let key = list.get_or(parts, n - 1, "")
  let downs = list.map(mods, (m) => "kd:" + m)
  let ups = list.map(list.reverse(mods), (m) => "ku:" + m)
  downs + key_press(key) + ups
}

effect fn shot_result(sz: Size) -> Result[Value, String] = {
  let b = screenshot(sz)!
  ok(json.array([image_block(b)]))
}

effect fn text_result(s: String) -> Result[Value, String] =
  ok(json.array([text_block(s)]))

// Execute one computer action; return the tool_result content array.
effect fn do_action(input: Value, sz: Size) -> Result[Value, String] = {
  let action = getf(input, "action")
  let xy = coord(input)
  let x = int.to_string(xy.0)
  let y = int.to_string(xy.1)
  match action {
    "screenshot" => shot_result(sz),
    "left_click" => { let _ = click(["c:${x},${y}"])! ; shot_result(sz) },
    "right_click" => { let _ = click(["rc:${x},${y}"])! ; shot_result(sz) },
    "middle_click" => { let _ = click(["c:${x},${y}"])! ; shot_result(sz) },
    "double_click" => { let _ = click(["dc:${x},${y}"])! ; shot_result(sz) },
    "mouse_move" => { let _ = click(["m:${x},${y}"])! ; shot_result(sz) },
    "type" => { let _ = click(["t:" + getf(input, "text")])! ; shot_result(sz) },
    "key" => { let _ = click(key_args(getf(input, "text")))! ; shot_result(sz) },
    "wait" => { process.sleep(1000) ; shot_result(sz) },
    "cursor_position" => { let p = click(["p:."])! ; text_result(string.trim(p)) },
    _ => text_result("action '${action}' is not supported by manus v${VERSION}"),
  }
}

// ── response parsing ──
fn block_type(b: Value) -> String =
  json.get_string(b, "type") |> option.unwrap_or("")

fn find_tool_use(content: List[Value]) -> Option[Value] =
  list.find(content, (b) => block_type(b) == "tool_use")

effect fn print_text(content: List[Value]) -> Unit = {
  let texts = content |> list.filter_map((b) =>
    if block_type(b) == "text" then json.get_string(b, "text") else none)
  let joined = string.trim(string.join(texts, ""))
  io.print(if joined == "" then "" else "\n[claude] ${joined}\n")
  ()
}

// ── Anthropic call ──
effect fn require_env(key: String) -> Result[String, String] =
  match env.get(key) {
    some(v) => if v == "" then err("empty env: ${key}") else ok(v),
    none => err("missing env: ${key}"),
  }

effect fn call_api(model: String, sz: Size, messages: List[Value]) -> Result[Value, String] = {
  let api_key = require_env("ANTHROPIC_API_KEY")!
  let body = json.object([
    ("model", json.from_string(model)),
    ("max_tokens", json.from_int(4096)),
    ("system", json.from_string(SYSTEM_PROMPT)),
    ("tools", json.array([computer_tool(sz)])),
    ("messages", json.array(messages)),
  ])
  let headers = [
    "x-api-key": api_key,
    "anthropic-version": "2023-06-01",
    "anthropic-beta": BETA,
    "content-type": "application/json",
  ]
  match http.request("POST", "https://api.anthropic.com/v1/messages", json.stringify(body), headers) {
    err(e) => err("http: ${e}"),
    ok(raw) => match json.parse(raw) {
      err(e) => err("json parse: ${e}"),
      ok(parsed) => match json.get(parsed, "error") |> option.flat_map((x) => json.get_string(x, "message")) {
        some(m) => err("anthropic api: ${m}"),
        none => ok(parsed),
      },
    },
  }
}

// ── confirmation ──
effect fn confirm(action: String, input: Value) -> Bool = {
  io.print("[manus] ${action}  ${json.stringify(input)}\n")
  io.print("        run this action? [y/N] ")
  let ans = string.trim(io.read_line())
  ans == "y" or ans == "Y" or ans == "yes"
}

// ── agent loop ──
effect fn run(model: String, sz: Size, messages: List[Value], step: Int, yolo: Bool) -> Result[Unit, String] = {
  guard step < MAX_STEPS else { io.print("\n[manus] step limit reached.\n") ; ok(()) }
  let resp = call_api(model, sz, messages)!
  let content = json.get_array(resp, "content") |> option.unwrap_or([])
  let stop = json.get_string(resp, "stop_reason") |> option.unwrap_or("")
  print_text(content)
  match find_tool_use(content) {
    none => { io.print("\n[manus] finished (${stop}).\n") ; ok(()) },
    some(tu) => {
      let id = getf(tu, "id")
      let input = json.get(tu, "input") |> option.unwrap_or(json.null())
      let action = getf(input, "action")
      let go = if yolo then true else confirm(action, input)
      if not go then { io.print("[manus] stopped by user.\n") ; ok(()) }
      else {
        let result_content = do_action(input, sz)!
        let assistant = msg("assistant", json.array(content))
        let tr = json.object([
          ("type", json.from_string("tool_result")),
          ("tool_use_id", json.from_string(id)),
          ("content", result_content),
        ])
        let user = msg("user", json.array([tr]))
        run(model, sz, messages + [assistant, user], step + 1, yolo)
      }
    },
  }
}

effect fn main() -> Result[Unit, String] = {
  let argv = process.args()
  let joined = string.trim(string.join(list.drop(argv, 1), " "))
  let task = if joined == "" then env.get("MANUS_TASK") |> option.unwrap_or("") else joined
  guard task != "" else {
    io.print("manus v${VERSION} — a Claude computer-use agent for macOS\n\n")
    io.print("usage:  manus \"<task>\"\n")
    io.print("env:    ANTHROPIC_API_KEY (required), MANUS_MODEL, MANUS_YOLO=1\n")
    ok(())
  }
  let model = env.get("MANUS_MODEL") |> option.unwrap_or(default_model())
  let yolo = (env.get("MANUS_YOLO") |> option.unwrap_or("")) == "1"
  let sz = screen_size()!
  io.print("manus v${VERSION}  model=${model}  screen=${int.to_string(sz.w)}x${int.to_string(sz.h)}  yolo=${if yolo then "on" else "off"}\n")
  io.print("task: ${task}\n")
  let shot = screenshot(sz)!
  let first = msg("user", json.array([text_block("Task: ${task}"), image_block(shot)]))
  run(model, sz, [first], 0, yolo)
}

// ── tests ──

test "one_modifier normalizes aliases" {
  assert_eq(one_modifier("command"), "cmd")
  assert_eq(one_modifier("option"), "alt")
  assert_eq(one_modifier("control"), "ctrl")
  assert_eq(one_modifier("nope"), "")
}

test "key_args maps modifiers and named keys" {
  assert_eq(string.join(key_args("cmd+a"), " "), "kd:cmd t:a ku:cmd")
  assert_eq(string.join(key_args("ctrl+shift+t"), " "), "kd:ctrl kd:shift t:t ku:shift ku:ctrl")
  assert_eq(string.join(key_args("Return"), " "), "kp:return")
  assert_eq(string.join(key_args("Left"), " "), "kp:arrow-left")
}

test "coord extracts x,y from the coordinate array" {
  let input = json.object([("coordinate", json.array([json.from_int(12), json.from_int(34)]))])
  assert_eq(coord(input).0, 12)
  assert_eq(coord(input).1, 34)
}
